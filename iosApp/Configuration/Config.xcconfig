// below overrides them with the Git-derived values; ProcessInfoPlistFile substitutes whichever
// wins into both Info.plists.
APP_VERSION_NAME=v0.0.0.unstamped
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=0.0.0

#include? "Version.xcconfig"
